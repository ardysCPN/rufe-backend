<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    name="sub_activos"
    pageWidth="555"
    pageHeight="200"
    columnWidth="555"
    leftMargin="0"
    rightMargin="0"
    topMargin="0"
    bottomMargin="0"
    whenNoDataType="AllSectionsNoDetail">

    <field name="sector" class="java.lang.String"/>
    <field name="tipoCultivo" class="java.lang.String"/>
    <field name="especieAnimal" class="java.lang.String"/>

    <title>
        <band height="25">
            <staticText>
                <reportElement x="0" y="5" width="555" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[ACTIVOS AGROPECUARIOS]]></text>
            </staticText>
        </band>
    </title>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="150" height="20"/>
                <textFieldExpression><![CDATA[$F{sector}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="160" y="0" width="180" height="20"/>
                <textFieldExpression><![CDATA[$F{tipoCultivo}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="350" y="0" width="180" height="20"/>
                <textFieldExpression><![CDATA[$F{especieAnimal}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>
