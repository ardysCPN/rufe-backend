<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="sub_integrantes"
    pageWidth="555"
    pageHeight="200"
    columnWidth="555"
    leftMargin="0"
    rightMargin="0"
    topMargin="0"
    bottomMargin="0"
    whenNoDataType="AllSectionsNoDetail">

    <field name="nombres" class="java.lang.String"/>
    <field name="apellidos" class="java.lang.String"/>
    <field name="numeroDocumento" class="java.lang.String"/>
    <field name="telefono" class="java.lang.String"/>

    <title>
        <band height="25">
            <staticText>
                <reportElement x="0" y="5" width="555" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[INTEGRANTES DEL HOGAR]]></text>
            </staticText>
        </band>
    </title>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="150" height="20"/>
                <textFieldExpression><![CDATA[$F{nombres} + " " + $F{apellidos}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="160" y="0" width="150" height="20"/>
                <textFieldExpression><![CDATA[$F{numeroDocumento}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="320" y="0" width="150" height="20"/>
                <textFieldExpression><![CDATA[$F{telefono}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>
